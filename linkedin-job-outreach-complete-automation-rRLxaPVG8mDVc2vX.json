    {
      "parameters": {
        "jsCode": "// Extract and enrich with Apollo contact data\nconst apolloResponse = $input.item().json;\nconst contacts = apolloResponse.people || [];\n\nif (contacts.length > 0) {\n  const topContact = contacts[0]; // Get top match\n  return {\n    hiringManager: `${topContact.first_name} ${topContact.last_name}`,\n    hiringManagerId: topContact.id,\n    hiringEmail: topContact.email,\n    hiringLinkedIn: topContact.linkedin_url,\n    hiringManagerTitle: topContact.title,\n    hiringManagerPhone: topContact.phone || 'N/A'\n  };\n} else {\n  return {\n    hiringManager: 'Not found',\n    hiringManagerId: '',\n    hiringEmail: '',\n    hiringLinkedIn: '',\n    hiringManagerTitle: '',\n    hiringManagerPhone: ''\n  };\n}"
      },
      "name": "Parse Apollo Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        688
      ],
      "id": "afb9e877-df83-43a1-a835-079113861e85"
    },
    {
      "parameters": {
        "jsCode": "// Analyze job description and generate personalized bullet points\nconst jobDesc = $json.description || '';\nconst jobTitle = $json.title || '';\nconst company = $json.company || '';\n\nconst techKeywords = [\n  'Python', 'JavaScript', 'TypeScript', 'SQL', 'AWS', 'GCP', 'Azure',\n  'React', 'Node.js', 'Kubernetes', 'Docker', 'CI/CD',\n  'Machine Learning', 'AI', 'Data Analytics', 'DevOps'\n];\n\nconst softSkills = [\n  'Leadership', 'Management', 'Communication', 'Agile',\n  'Cross-functional', 'Problem-solving', 'Strategic'\n];\n\nconst matchedTechSkills = techKeywords.filter(skill => \n  jobDesc.toUpperCase().includes(skill.toUpperCase())\n).slice(0, 3);\n\nconst matchedSoftSkills = softSkills.filter(skill =>\n  jobDesc.toUpperCase().includes(skill.toUpperCase())\n).slice(0, 2);\n\nconst bulletPoints = [\n  matchedTechSkills.length > 0 ? `Delivered solutions using ${matchedTechSkills.join(', ')} at scale` : null,\n  matchedSoftSkills.length > 0 ? `${matchedSoftSkills[0]} leader driving team performance and innovation` : null,\n  `Optimized critical processes reducing operational costs by 40%+`,\n  `Successfully shipped 15+ major features impacting 100K+ users`,\n  `Mentored junior engineers and established engineering best practices`\n].filter(Boolean).slice(0, 4);\n\nreturn {\n  ...{{$json}},\n  matchedTechSkills,\n  matchedSoftSkills,\n  bulletPoints,\n  personalizedSummary: bulletPoints.join(' | ')\n};"
      },
      "name": "Step 4: Analyze & Personalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        688
      ],
      "id": "17aa1292-f24d-4097-a2e9-9809f3362c8d"
    },
