    {
      "parameters": {
        "jsCode": "// استلام البيانات من الـ AI Agent\nconst data = $json; \n\n// تصميم الـ HTML والـ CSS\nconst html = `\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        :root { --primary: #2563eb; --text: #1f2937; }\n        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: var(--text); line-height: 1.5; padding: 0; margin: 0; }\n        .container { padding: 30px; }\n        .header { background: #f3f4f6; padding: 30px; border-left: 10px solid var(--primary); }\n        .name { font-size: 32px; font-weight: 800; color: var(--primary); text-transform: uppercase; }\n        .contact-info { font-size: 14px; margin-top: 10px; display: flex; gap: 15px; flex-wrap: wrap; }\n        .section { margin-top: 25px; }\n        .section-title { font-size: 18px; font-weight: bold; border-bottom: 2px solid #e5e7eb; color: var(--primary); padding-bottom: 5px; margin-bottom: 15px; }\n        .exp-item { margin-bottom: 15px; }\n        .exp-header { display: flex; justify-content: space-between; font-weight: bold; }\n        .date { color: #6b7280; font-size: 13px; }\n        .skills-grid { display: flex; gap: 8px; flex-wrap: wrap; }\n        .skill-tag { background: #dbeafe; color: #1e40af; padding: 4px 12px; border-radius: 15px; font-size: 12px; font-weight: 600; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <div class=\"name\">${data.prenom || ''} ${data.nom || ''}</div>\n        <div class=\"contact-info\">\n            <span>📍 ${data.ville || ''}</span>\n            <span>📧 ${data.email || ''}</span>\n            <span>📞 ${data.telephone || ''}</span>\n        </div>\n        <p style=\"margin-top: 15px; font-style: italic;\">${data.profil || ''}</p>\n    </div>\n\n    <div class=\"container\">\n        <div class=\"section\">\n            <div class=\"section-title\">COMPÉTENCES</div>\n            <div class=\"skills-grid\">\n                ${(data.competences || []).map(s => `<span class=\"skill-tag\">${s}</span>`).join('')}\n            </div>\n        </div>\n\n        <div class=\"section\">\n            <div class=\"section-title\">EXPÉRIENCES PROFESSIONNELLES</div>\n            ${(data.experiences || []).map(exp => `\n                <div class=\"exp-item\">\n                    <div class=\"exp-header\">\n                        <span>${exp.poste} @ ${exp.entreprise}</span>\n                        <span class=\"date\">${exp.date_debut} - ${exp.date_fin}</span>\n                    </div>\n                    <p style=\"margin-top: 5px; font-size: 14px;\">${exp.description}</p>\n                </div>\n            `).join('')}\n        </div>\n\n        <div class=\"section\">\n            <div class=\"section-title\">FORMATION</div>\n            ${(data.formations || []).map(f => `\n                <div class=\"exp-item\">\n                    <div class=\"exp-header\">\n                        <span>${f.diplome}</span>\n                        <span class=\"date\">${f.annee}</span>\n                    </div>\n                    <div style=\"font-size: 14px;\">${f.etablissement}</div>\n                </div>\n            `).join('')}\n        </div>\n    </div>\n</body>\n</html>\n`;\n\nreturn { html };"
      },
