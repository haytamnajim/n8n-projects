      "name": "Extraire URLs images galerie"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst urlsSet = new Set();\n\nfor (const item of allItems) {\n  const contentArray = item.json.content;\n  if (!Array.isArray(contentArray) || !contentArray[0] || !contentArray[0].text) continue;\n\n  const text = contentArray[0].text;\n  const match = text.match(/```json\\n([\\s\\S]*?)\\n```/);\n  if (!match) continue;\n\n  try {\n    const imagesArray = JSON.parse(match[1]);\n    if (Array.isArray(imagesArray)) {\n      imagesArray.forEach(img => {\n        if (img.src) urlsSet.add(img.src);\n      });\n    }\n  } catch (e) {\n    continue;\n  }\n}\n\nconst uniqueUrls = Array.from(urlsSet);\n\n// ⚠️ On force toujours au moins un item en sortie\nif (uniqueUrls.length === 0) {\n  return [{ json: { empty: true, message: \"Aucune image trouvée dans la galerie\" } }];\n}\n\nreturn uniqueUrls.map((url, index) => ({\n  json: { index: index + 1, url: url }\n}));"
      },
