    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\nconst html = `\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        body { font-family: 'Arial', sans-serif; margin: 0; padding: 0; background: #f4f7f6; color: #333; }\n        .cv-container { width: 800px; margin: auto; background: white; min-height: 1000px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }\n        .header { background: #1a365d; color: white; padding: 40px; text-align: center; }\n        .name { font-size: 28px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }\n        .title { font-size: 18px; color: #63b3ed; margin-top: 10px; }\n        .main { display: flex; }\n        .sidebar { width: 30%; background: #2d3748; color: white; padding: 20px; font-size: 13px; }\n        .content { width: 70%; padding: 30px; }\n        .section-title { border-bottom: 2px solid #1a365d; color: #1a365d; font-weight: bold; margin-bottom: 15px; padding-bottom: 5px; text-transform: uppercase; }\n        .job { margin-bottom: 20px; }\n        .job-header { display: flex; justify-content: space-between; font-weight: bold; }\n        .tag { background: #edf2f7; color: #2d3748; padding: 4px 10px; border-radius: 4px; display: inline-block; margin: 2px; font-size: 12px; }\n    </style>\n</head>\n<body>\n    <div class=\"cv-container\">\n        <div class=\"header\">\n            <div class=\"name\">${data.prenom || ''} ${data.nom || ''}</div>\n            <div class=\"title\">${data.poste_recherche || ''}</div>\n        </div>\n        <div class=\"main\">\n            <div class=\"sidebar\">\n                <h3>CONTACT</h3>\n                <p>📍 ${data.ville || ''}</p>\n                <p>📞 ${data.telephone || ''}</p>\n                <p>📧 ${data.email || ''}</p>\n                <br>\n                <h3>COMPÉTENCES</h3>\n                ${(data.competences || []).map(s => `<div class=\"tag\">${s}</div>`).join('')}\n            </div>\n            <div class=\"content\">\n                <div class=\"section-title\">Profil</div>\n                <p>${data.profil || ''}</p>\n                \n                <div class=\"section-title\">Expériences</div>\n                ${(data.experiences || []).map(exp => `\n                    <div class=\"job\">\n                        <div class=\"job-header\">\n                            <span>${exp.poste}</span>\n                            <span style=\"color:#718096\">${exp.date_debut} - ${exp.date_fin}</span>\n                        </div>\n                        <div style=\"font-style: italic; color: #4a5568;\">${exp.entreprise}</div>\n                        <p style=\"font-size: 14px;\">${exp.description}</p>\n                    </div>\n                `).join('')}\n            </div>\n        </div>\n    </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html: html } }];"
      },
