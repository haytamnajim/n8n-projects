    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet results = [];\n\nitems.forEach(item => {\n    const fullText = item.json.text;\n\n    // تقسيم النص اعتماداً على \"Rule\" أو \"القاعدة\" متبوعين برقم\n    const ruleSections = fullText.split(/(?=(?:Rule|القاعدة)\\s+\\d+)/i);\n\n    ruleSections.forEach(section => {\n        if (section.trim().length > 0) {\n\n            // استخراج رقم القاعدة سواء كانت مكتوبة بالعربية أو الإنجليزية\n            const match = section.match(/(?:Rule|القاعدة)\\s+(\\d+)/i);\n            const ruleNum = match ? parseInt(match[1], 10) : null;\n\n            results.push({\n                json: {\n                    content: section.trim(),\n                    metadata: {\n                        ruleNumber: ruleNum,\n                        source: \"Règles du golf - PDF\"\n                    }\n                }\n            });\n        }\n    });\n});\n\nreturn results;\n"
      },
