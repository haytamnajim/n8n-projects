      ],
      "id": "c46f0eeb-77a8-4030-9cba-4cef527212c3",
      "name": "Gemini AI Prompt"
    },
    {
      "parameters": {
        "jsCode": "// 1. استخراج النص من رد Gemini\nconst rawText = $json.candidates[0].content.parts[0].text;\n\n// دالة لتنظيف النص من ( \" , \\n , \\t , \\r )\nconst cleanString = (str) => {\n  if (!str) return \"\";\n  return str.replace(/[\\n\\t\\r\"]/g, ' ').trim(); // استبدالها بمسافة لمنع التصاق الكلمات\n};\n\ntry {\n  // 2. محاولة استخراج وتحويل الـ JSON من داخل النص\n  const jsonStart = rawText.indexOf('[');\n  const jsonEnd = rawText.lastIndexOf(']') + 1;\n  \n  if (jsonStart !== -1 && jsonEnd !== -1) {\n    const jsonString = rawText.substring(jsonStart, jsonEnd);\n    let scenes = JSON.parse(jsonString);\n    \n    const result = Array.isArray(scenes) ? scenes : [scenes];\n    \n    return result.map(scene => ({\n      ...scene,\n      text: cleanString(scene.text) // تنظيف النص داخل المصفوفة\n    }));\n\n  } else {\n    // خطة احتياطية: تنظيف النص الخام بالكامل\n    return [{\n      text: cleanString(rawText), \n      image_prompt: \"abstract technology background, cinematic lighting\",\n      duration: 7\n    }];\n  }\n} catch (e) {\n  return [{\n    text: \"Erreur de traitement des données\",\n    image_prompt: \"error screen background\",\n    duration: 5\n  }];\n}"
      },
