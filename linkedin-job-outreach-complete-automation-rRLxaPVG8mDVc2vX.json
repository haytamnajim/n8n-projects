    {
      "parameters": {
        "jsCode": "// Parse jobs from Apify LinkedIn Scraper response\nconst jobs = $input.all().map(item => ({\n  jobId: item.json.id || item.json.trackingId || '',\n  title: item.json.title || '',\n  company: item.json.companyName || 'Unknown',\n  companyId: item.json.companyId || '',\n  location: item.json.location || '',\n  url: item.json.link || '',\n  postedDate: item.json.postedAt ? new Date(item.json.postedAt).toLocaleDateString('en-US') : '',\n  postedDateUnix: item.json.postedAt || '',\n  description: item.json.descriptionHtml || item.json.description || '',\n  salary: item.json.salary || 'Not specified',\n  applicationStatus: 'Pending',\n  hiringManager: '',\n  hiringManagerId: '',\n  hiringEmail: '',\n  hiringLinkedIn: '',\n  linkedinMessageSent: 'No',\n  appliedDate: '',\n  notes: ''\n}));\n\nreturn jobs;"
      },
      "name": "Parse Jobs Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        688
      ],
      "id": "48c3a178-ad92-4a4d-b787-9f9ef8fdd0a0"
