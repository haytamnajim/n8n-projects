      "parameters": {
        "jsCode": "// Récupère l'URL de l'image depuis Cloudinary\nconst imageUrl = $('Upload an asset from file data1').first().json.secure_url;\n\n// Récupère les données de la scène depuis l'entrée de la boucle\nconst sceneData = $('Loop Over Items').first().json;\n\n// Retourne la scène mise à jour avec l'URL de l'image\nreturn {\n  json: {\n    ...sceneData,\n    image_url: imageUrl\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
