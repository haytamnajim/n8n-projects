    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Force un prompt 100% en anglais et dépouillé\nlet promptText = item.image_prompt || 'stick figure walking';\npromptText = promptText.replace(/[^a-zA-Z0-9 ]/g, ' '); // Enlève caractères spéciaux\n\n// Style strict bonhomme allumette 2D\nconst finalPrompt = `simple stick figure drawing, 2d vector art, black ink line art, clean white background, minimalist cartoon, ${promptText}`;\nconst randomSeed = Math.floor(Math.random() * 999999);\n\nconst url = `https://image.pollinations.ai/prompt/${encodeURIComponent(finalPrompt)}?width=1280&height=720&model=turbo&seed=${randomSeed}&nologo=true`;\n\nreturn {\n  json: {\n    ...item,\n    pollinations_url: url\n  }\n};\n"
      },
