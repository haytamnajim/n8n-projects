    {
      "parameters": {
        "jsCode": "const rawAiOutput = items[0].json.output || \"\"; \nconst rawData = $node[\"Webhook\"].json.body; \n\nconst clean = (text) => {\n    return String(text || \"\").replace(/[\\*\\#]/g, '').trim();\n};\n\nconst aiOutput = clean(rawAiOutput);\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: sans-serif; margin: 0; display: flex; min-height: 100vh; }\n        .sidebar { width: 30%; background: #2c3e50; color: white; padding: 30px 20px; }\n        .main { width: 70%; padding: 40px; background: white; }\n        .sidebar h1 { font-size: 24px; margin: 0; text-transform: uppercase; }\n        h2 { color: #2c3e50; border-bottom: 2px solid #e74c3c; padding-bottom: 5px; text-transform: uppercase; font-size: 18px; }\n        .content { font-size: 13px; white-space: pre-line; color: #34495e; }\n    </style>\n</head>\n<body>\n    <div class=\"sidebar\">\n        <h1>${clean(rawData.prenom)}</h1>\n        <p>📧 ${clean(rawData.email)}</p>\n        <p>📱 ${clean(rawData.telephone)}</p>\n        <p>📍 ${clean(rawData.localisation)}</p>\n    </div>\n    <div class=\"main\">\n        <h2>À propos de moi</h2>\n        <div class=\"content\">${aiOutput}</div>\n        <h2>Compétences</h2>\n        <div class=\"content\">${clean(rawData.competences)}</div>\n    </div>\n</body>\n</html>\n`;\nreturn [{ json: { html: htmlContent } }];"
      },
