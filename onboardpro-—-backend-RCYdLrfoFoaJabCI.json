    {
      "parameters": {
        "jsCode": "// 1) Read raw AI output\nlet raw = $json.output || \"\";\n\n// 2) Clean escaped characters\nraw = raw\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\\\\\n/g, \"\\n\");\n\n// 3) Split into paragraphs using real line breaks\nlet paragraphs = raw\n  .split(/\\n+/)\n  .map(p => p.trim())\n  .filter(p => p.length > 0);\n\n// 4) Convert each paragraph into HTML <p> blocks\nlet htmlBody = paragraphs.map(p => `<p>${p}</p>`).join(\"\\n\");\n\n// 5) Extract subject or default\nlet subject = \"Welcome to the Company!\";\nconst match = raw.match(/Subject:\\s*(.*?)\\n/i);\nif (match) {\n  subject = match[1].trim();\n}\n\n// 6) Return HTML email\nreturn [\n  {\n    json: {\n      subject,\n      htmlEmail: htmlBody\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
