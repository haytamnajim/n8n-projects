    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const now = new Date();\n\n// 🔹 récupérer expires_at depuis Google Sheets\nconst expiresAtRaw = $node[\"Get row(s) in sheet\"].json.expires_at;\n\nif (!expiresAtRaw) {\n  throw new Error('expires_at est manquant');\n}\n\nconst expiresAt = new Date(expiresAtRaw);\n\nif (isNaN(expiresAt.getTime())) {\n  throw new Error('expires_at invalide: ' + expiresAtRaw);\n}\n\nconst diffMs = expiresAt - now;\nconst daysLeft = Math.floor(diffMs / (1000 * 60 * 60 * 24));\n\nconst expired = daysLeft <= 0;\nconst almostExpired = daysLeft > 0 && daysLeft <= 7;\n\nreturn {\n  api_name: $node[\"Get row(s) in sheet\"].json.api_name,\n  endpoint: $node[\"Get row(s) in sheet\"].json.endpoint,\n  expires_at: expiresAt.toISOString(),\n  days_left: daysLeft,\n  expired,\n  almost_expired: almostExpired,\n  owner: $node[\"Get row(s) in sheet\"].json.owner\n};\n"
      },
