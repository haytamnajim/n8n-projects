    {
      "parameters": {
        "jsCode": "// Read from webhook body\nconst firstName = $json.body.first_name;\nconst lastName = $json.body.last_name;\n\n// Validation\nif (!firstName || !lastName) {\n  throw new Error(\"first_name or last_name is missing from the input JSON\");\n}\n\n// Domain\nconst domain = \"company.com\";\n\n// Generate email\nconst email = `${firstName}.${lastName}@${domain}`.toLowerCase();\n\n// Function to generate random secure password\nfunction generatePassword(length = 12) {\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=\";\n  let pass = \"\";\n  for (let i = 0; i < length; i++) {\n    pass += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n  return pass;\n}\n\n// Generate password\nconst password = generatePassword(12);\n\n// Function to generate a unique user ID (e.g., \"USR-8fj39dk2\")\nfunction generateUserId() {\n  const randomStr = Math.random().toString(36).substring(2, 10);\n  return `USR-${randomStr}`.toUpperCase();  // Optional: remove .toUpperCase() if not desired\n}\n\n// Generate user ID\nconst userId = generateUserId();\n\n// Return everything\nreturn [\n  {\n    json: {\n      email,\n      password,\n      userId\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
