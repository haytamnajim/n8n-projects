    {
      "parameters": {
        "jsCode": "// Format data for Google Sheets\nreturn $input.all().map(item => ({\n  json: {\n    'Job ID': item.json.jobId || '',\n    'Job Title': item.json.title || '',\n    'Company': item.json.company || '',\n    'Location': item.json.location || '',\n    'Job URL': item.json.url || '',\n    'Posted Date': item.json.postedDate || '',\n    'Salary': item.json.salary || '',\n    'Job Description': (item.json.description || '').substring(0, 200) + '...',\n    'Hiring Manager': item.json.hiringManager || '',\n    'Hiring Email': item.json.hiringEmail || '',\n    'Hiring LinkedIn': item.json.hiringLinkedIn || '',\n    'Application Status': item.json.applicationStatus || 'Pending',\n    'LinkedIn Message Sent': item.json.linkedinMessageSent || 'No',\n    'Added Date': new Date().toLocaleDateString('en-US')\n  }\n}));"
      },
