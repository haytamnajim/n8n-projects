    {
      "parameters": {
        "jsCode": "// Filter jobs posted this week only\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst filteredJobs = $input.all().filter(item => {\n  const jobDate = new Date(item.json.postedDateUnix);\n  return jobDate > weekAgo;\n});\n\nconsole.log(`Found ${filteredJobs.length} jobs posted this week out of ${$input.all().length} total`);\nreturn filteredJobs;"
      },
      "name": "Filter Week Jobs Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        688
      ],
      "id": "bea3c30d-5c47-41a4-bf83-de3cbdae8e76"
    },
    {
      "parameters": {
        "jsCode": "// Check if job is older than 30 days (backup filter)\nconst thirtyDaysAgo = new Date();\nthirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);\n\nreturn $input.all().filter(item => {\n  const jobDate = new Date(item.json.postedDateUnix);\n  return jobDate > thirtyDaysAgo;\n});"
      },
      "name": "Filter - Remove Old Jobs",
