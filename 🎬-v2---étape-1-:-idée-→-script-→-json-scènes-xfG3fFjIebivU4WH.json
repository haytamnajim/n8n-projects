        "jsCode": "// Récupère l'URL audio depuis Cloudinary\nconst audioUrl = $('Upload an asset from file data').first().json.secure_url;\n\n// Récupère les scènes depuis le nœud Code précédent\nconst scenes = $('Code in JavaScript').first().json.scenes;\n\n// Retourne chaque scène comme un item séparé avec l'URL audio\nreturn scenes.map(scene => ({\n  json: {\n    ...scene,\n    audio_url: audioUrl\n  }\n}));\n"
