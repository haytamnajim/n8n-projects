    {
      "parameters": {
        "jsCode": "const rawAiOutput = items[0].json.output || \"\"; \nconst rawData = $node[\"Webhook\"].json.body; \n\nconst clean = (text) => {\n    return String(text || \"\").replace(/[\\*\\#]/g, '').trim();\n};\n\nconst aiOutput = clean(rawAiOutput);\n\nconst htmlContent = `\n<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: \"Times New Roman\", serif; padding: 50px; color: #000; line-height: 1.5; }\n        .header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 30px; }\n        h1 { font-size: 26pt; margin: 0; text-transform: uppercase; }\n        h2 { font-size: 14pt; text-transform: uppercase; border-bottom: 1px solid #000; margin-top: 25px; }\n        .content { font-size: 12pt; text-align: justify; white-space: pre-line; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>${clean(rawData.prenom)} ${clean(rawData.nom)}</h1>\n        <div>${clean(rawData.email)} | ${clean(rawData.telephone)}</div>\n    </div>\n    <h2>Résumé Professionnel</h2>\n    <div class=\"content\">${aiOutput}</div>\n    <h2>Expertise</h2>\n    <div class=\"content\">${clean(rawData.competences)}</div>\n</body>\n</html>\n`;\nreturn [{ json: { html: htmlContent } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        128
      ],
      "id": "ac0ae104-f21c-4ebc-a797-baf1debb1606",
