    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const text = item.json?.content?.[0]?.text || '';\n\n  if (!text) {\n    throw new Error(`Aucun texte trouvé pour l'item ${index + 1}`);\n  }\n\n  // Rechercher l'image Base64 dans la réponse\n  const match = text.match(\n    /data:image\\/([a-zA-Z0-9.+-]+);base64,([A-Za-z0-9+/=\\r\\n]+)/\n  );\n\n  if (!match) {\n    throw new Error(\n      `Aucune image Base64 trouvée dans l'item ${index + 1}`\n    );\n  }\n\n  const extension = match[1].split('+')[0];\n  const mimeType = `image/${match[1]}`;\n  const base64 = match[2].replace(/\\s/g, '');\n\n  return {\n    json: {\n      index: index + 1,\n      mimeType: mimeType,\n      extension: extension,\n      fileName: `google-flow-${index + 1}.${extension}`,\n    },\n\n    binary: {\n      data: {\n        data: base64,\n        mimeType: mimeType,\n        fileName: `google-flow-${index + 1}.${extension}`,\n      },\n    },\n  };\n});"
      },
