      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\n\nconst data = JSON.parse(raw);\n\n// Narration complète pour ElevenLabs plus tard\ndata.full_narration = data.scenes.map(s => s.narration).join(' ');\n\nreturn { json: data };\n"
