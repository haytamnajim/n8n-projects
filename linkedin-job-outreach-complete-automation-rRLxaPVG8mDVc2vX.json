    {
      "parameters": {
        "jsCode": "// Parse jobs from Apify LinkedIn Scraper response\nconst jobs = $input.all().map(item => ({\n  jobId: item.json.id || item.json.trackingId || '',\n  title: item.json.title || '',\n  company: item.json.companyName || 'Unknown',\n  companyId: item.json.companyId || '',\n  location: item.json.location || '',\n  url: item.json.link || '',\n  postedDate: item.json.postedAt ? new Date(item.json.postedAt).toLocaleDateString('en-US') : '',\n  postedDateUnix: item.json.postedAt || '',\n  description: item.json.descriptionHtml || item.json.description || '',\n  salary: item.json.salary || 'Not specified',\n  applicationStatus: 'Pending',\n  hiringManager: '',\n  hiringManagerId: '',\n  hiringEmail: '',\n  hiringLinkedIn: '',\n  linkedinMessageSent: 'No',\n  appliedDate: '',\n  notes: ''\n}));\n\nreturn jobs;"
      },
      "name": "Parse Jobs Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        688
      ],
      "id": "48c3a178-ad92-4a4d-b787-9f9ef8fdd0a0"
    },
    {
      "parameters": {
        "jsCode": "// Filter jobs posted this week only\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst filteredJobs = $input.all().filter(item => {\n  const jobDate = new Date(item.json.postedDateUnix);\n  return jobDate > weekAgo;\n});\n\nconsole.log(`Found ${filteredJobs.length} jobs posted this week out of ${$input.all().length} total`);\nreturn filteredJobs;"
      },
      "name": "Filter Week Jobs Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        688
      ],
      "id": "bea3c30d-5c47-41a4-bf83-de3cbdae8e76"
    },
    {
      "parameters": {
        "jsCode": "// Check if job is older than 30 days (backup filter)\nconst thirtyDaysAgo = new Date();\nthirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);\n\nreturn $input.all().filter(item => {\n  const jobDate = new Date(item.json.postedDateUnix);\n  return jobDate > thirtyDaysAgo;\n});"
      },
      "name": "Filter - Remove Old Jobs",
