        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es un conteur d'histoires émouvantes en français. Retourne UNIQUEMENT un JSON valide sans texte autour avec ce format : {\\\"topic\\\": \\\"...\\\", \\\"title\\\": \\\"...\\\", \\\"total_duration\\\": 25, \\\"scenes\\\": [{\\\"scene\\\": 1, \\\"start\\\": 0, \\\"duration\\\": 5, \\\"narration\\\": \\\"texte français...\\\", \\\"image_prompt\\\": \\\"simple stick figure drawing, 2d line art on white background, english description\\\"}]}. Génère 5 scènes, durée totale 25 secondes. IMPORTANT FOR IMAGE_PROMPT: 1) MUST BE STRICTLY IN ENGLISH ONLY (NO FRENCH WORDS) 2) MUST START WITH: 'simple stick figure drawing, 2d vector line art on white background' 3) Simple scene description in English. Examples: 'two stick figures sitting on bench watching sunset', 'stick figure holding flowers near grave marker', 'stick figure walking alone under rain'.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Génère une histoire émouvante sur l'amitié ou la vie. Retourne uniquement le JSON.\"\n    }\n  ],\n  \"temperature\": 0.8\n}\n",
        "options": {}
      },
