    {
      "parameters": {
        "jsCode": "/* \n   Version Corrigée : Ajout manuel du domaine pour réparer les liens\n*/\nconst htmlBody = items[0].json.data;\n\n// ⬇️ MODIFICATION ICI : On indique directement le site car il a été perdu\nlet baseUrl = 'https://boss-luna.vercel.app';\n\n// Nettoyage de l'URL de base\nbaseUrl = baseUrl.replace(/\\/$/, '');\n\nif (typeof htmlBody !== 'string') {\n  return [];\n}\n\nconst regex = /<a\\s+(?:[^>]*?\\s+)?href=\"([^\"]+)\"/gi;\nconst matches = [...htmlBody.matchAll(regex)];\n\nreturn matches.map(match => {\n  let url = match[1];\n\n  // Filtres\n  if (!url || url.startsWith('#') || url.startsWith('javascript:')) {\n    return null;\n  }\n\n  // Reconstruction du lien complet\n  if (!url.startsWith('http')) {\n      if (!url.startsWith('/')) {\n        url = '/' + url;\n      }\n      url = baseUrl + url;\n  }\n\n  return {\n    json: {\n      url: url\n    }\n  };\n}).filter(item => item !== null);"
      },
