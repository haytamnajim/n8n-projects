        "jsonBody": "={\n  \"timeline\": {\n    \"tracks\": [\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"html\",\n              \"html\": \"<p align='center'>{{ $node['Format AI Response'].json['text'] }}</p>\",\n              \"css\": \"p { color: #ffffff; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 18px; background: rgba(0, 0, 0, 0.7); padding: 20px; border-radius: 15px; line-height: 1.4; width: 500px; margin: 0 auto; }\",\n              \"width\": 600,\n              \"height\": 300\n            },\n            \"start\": 0,\n            \"length\": 15,\n            \"position\": \"center\",\n            \"offset\": {\n              \"y\": -0.2\n            },\n            \"transition\": {\n              \"in\": \"slideUp\",\n              \"out\": \"fade\"\n            },\n            \"effect\": \"zoomIn\"\n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"image\",\n              \"src\": \"{{ $node['Upload Image to Cloud'].json['secure_url'] }}\"\n            },\n            \"start\": 0,\n            \"length\": 15,\n            \"effect\": \"zoomIn\" \n          }\n        ]\n      },\n      {\n        \"clips\": [\n          {\n            \"asset\": {\n              \"type\": \"audio\",\n              \"src\": \"{{ $node['Upload Audio to Cloud'].json['secure_url'] }}\"\n            },\n            \"start\": 0,\n            \"length\": 15\n          }\n        ]\n      }\n    ]\n  },\n  \"output\": {\n    \"format\": \"mp4\",\n    \"resolution\": \"hd\"\n  }\n}",
