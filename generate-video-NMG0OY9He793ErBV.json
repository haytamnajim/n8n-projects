        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=AIzaSyAfl2OxjB9vFo_LYafUcygMHA5jwSAVKlU\n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Explique en quelques phrases comment fonctionne l'intelligence artificielle.\"\n        }\n      ]\n    }\n  ]\n}\n",
