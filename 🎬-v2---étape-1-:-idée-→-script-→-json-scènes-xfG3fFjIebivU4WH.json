      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "// Récupère toutes les scènes traitées par la boucle\nconst scenes = $input.all().map(item => item.json);\n\n// URL audio de la voix-off\nconst audioUrl = scenes[0].audio_url;\n\n// Construction des scènes pour JSON2Video (5 images différentes)\nconst json2videoScenes = scenes.map(scene => {\n  return {\n    duration: scene.duration,\n    elements: [\n      {\n        type: \"image\",\n        src: scene.image_url,\n        resize: \"cover\"\n      }\n    ]\n  };\n});\n\n// JSON final pour JSON2Video\nconst json2videoPayload = {\n  resolution: \"full-hd\",\n  quality: \"medium\",\n  scenes: json2videoScenes,\n  elements: [\n    {\n      type: \"audio\",\n      src: audioUrl\n    }\n  ]\n};\n\nreturn { json: json2videoPayload };\n"
      },
