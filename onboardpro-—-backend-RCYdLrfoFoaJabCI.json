    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an HR assistant. Write a warm, professional welcome email formatted exactly as if it were being sent from Gmail.\n\n\n\nThe email must include:\n\nSubject: Welcome to ACME Technologies, {{ $json.FirstName }}!\n\nDear {{ $json.FirstName }},\n\nWelcome message…\n\nEmployee login details:\nEmail: {{ $json.Email }}\nUser ID: {{ $json.UserId }}\nTemporary Password: {{ $json.Password }}\n\n\nIMPORTANT RULES:\n- Do NOT output \\n or \\n\\n.\n- Do NOT use escape characters (\\, \\\", or \\\\).\n- Do NOT output the email as JSON or code.\n- The email must appear exactly as plain text with real paragraph spacing.\n- Use real line breaks (press ENTER).\n- Output ONLY the email text.\n\nClosing message…\n\nBest regards,\nACME Technologies HR Team\n",
        "options": {
          "systemMessage": "=You are an HR assistant."
        }
      },
