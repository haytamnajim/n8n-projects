      "id": "35210656-8b37-47ee-8044-e395512d2977",
      "name": "Sticky Note4"
    },
    {
      "parameters": {
        "jsCode": "// Récupérer et parser\nconst totalMB = $execution.customData.get('totalSize') || '0.00';\nconst totalEmails = $execution.customData.get('totalEmails') || 0;\nconst statsString = $execution.customData.get('stats');\nconst stats = statsString ? JSON.parse(statsString) : { newsletters: 0, gros: 0, anciens: 0, pieces_jointes: 0 };\n\nconst message = `🎉 Nettoyage Gmail terminé ! \n\n📊 STATISTIQUES\n━━━━━━━━━━━━━━━━\n📧 Total : ${totalEmails} emails\n💾 Espace : ${totalMB} Mo\n\n📂 DÉTAILS\n- 📰 Newsletters : ${stats.newsletters}\n- 🐘 Gros fichiers : ${stats.gros}\n- 📎 Pièces jointes : ${stats.pieces_jointes}\n- 📅 Autres : ${stats.anciens}\n\n🗑️ Corbeille Gmail vérifiée\n\n⏰ Prochain : Dimanche 3h`;\n\nreturn [{ \n  json: { \n    totalDeleted: totalEmails,\n    totalMB: totalMB,\n    message: message\n  } \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        192
      ],
      "id": "52eef761-5a76-4e75-b071-903245c92162",
      "name": "Préparer Synthèse"
    },
    {
      "parameters": {
        "jsCode": "// Garder les emails uniques basés sur leur ID\nconst unique = new Map();\nfor (const item of $input.all()) {\n  unique.set(item.json.id, item);\n}\nreturn Array.from(unique.values());"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        352
      ],
      "id": "eb8fdeb7-4c5a-4bbb-9c90-a4d08b4d6a0d",
      "name": "Suppression Doublons"
    },
    {
      "parameters": {
        "jsCode": "// Bloquer seulement les emails avec le label STARRED\nreturn $input.all().filter(item => {\n  const labels = item.json.labelIds || [];\n  return !labels.includes('STARRED');\n});"
      },
