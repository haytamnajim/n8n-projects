      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// Extraire JSON propre du LLM\nconst rawOutput = items[0].json.text || items[0].json.output || '{}';\nconst match = rawOutput.match(/\\{[\\s\\S]*\\}/);\nif(!match) throw new Error('JSON non trouvé');\nconst data = JSON.parse(match[0]);\nreturn [{ json: data }];"
      },
