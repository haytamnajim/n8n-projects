      "parameters": {
        "jsCode": "// Set input parameters for the workflow\nreturn {\n  company_domain: '{{ $json.company_domain || \"tesla.com\" }}',\n  spreadsheet_id: '{{ $json.spreadsheet_id }}',\n  search_keywords: '{{ $json.search_keywords || \"Software Engineer\" }}'\n};"
