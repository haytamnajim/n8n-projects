    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a LinkedIn post in French based on the following idea and article.\n\n<instructions>\n- Use the text provided in {{ $('Set data').item.json.Prompt }} as the main topic or idea for the post.\n- Use the link provided in {{ $('Get Ready Posts').item.json['Article Url'] }} as the reference source. Read and summarize the key points from it.\n- The post must be engaging and written for professionals and business owners interested in AI, automation, and productivity.\n- Do not use markdown formatting (LinkedIn doesn’t support bold, headers, etc.). Use clear line breaks instead.\n- Start with a strong hook: 2 short sentences that mention AI or automation and capture attention.\n- Then, summarize the key insights from the article in 2–3 short paragraphs.\n- Explain in one sentence why this topic matters for SMBs or entrepreneurs.\n- End with a simple call to action (e.g., “Et toi, qu’en penses-tu ?” or “Tu veux que je te montre comment l’appliquer à ton business ?”).\n- Include the article link at the end of the post under its summary.\n</instructions>\n\n<content>\nTopic: {{ $('Set data').item.json.Prompt }}\nArticle:{{ $('Set data').item.json.Article }} \n</content>\n"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        144,
        1536
      ],
      "id": "b2ecc01e-9b50-421c-a795-4495e0b7dff8",
      "name": "Basic LLM Chain1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Rewrite the following LinkedIn post in French to match the tone, rhythm, and storytelling style of the example post below.\n\n<instructions>\n- Keep the text plain (no markdown, no bold, no emojis, no *).\n- Follow the structure, tone, and sentence flow of the example post.\n- Maintain the same language level and voice consistency (if the example post is conversational, make this one conversational too).\n- Adapt the pacing: short impactful sentences, good breathing rhythm, natural flow.\n- Ensure the rewritten post sounds organic for LinkedIn (human, authentic, not AI-generated).\n- Keep the content faithful to the original message, but improve clarity and emotional connection if needed.\n</instructions>\n\n<ExamplePost>\n{{ $('Writing style').item.json.your_style }}\n</ExamplePost>\n\n<OriginalPost>\n{{ $json.text }}\n</OriginalPost>\n"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
