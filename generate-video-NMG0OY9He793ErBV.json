      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// 1. استخراج النص من رد Gemini\nconst rawText = $json.candidates[0].content.parts[0].text;\n\ntry {\n  // 2. محاولة استخراج وتحويل الـ JSON من داخل النص\n  const jsonStart = rawText.indexOf('[');\n  const jsonEnd = rawText.lastIndexOf(']') + 1;\n  \n  if (jsonStart !== -1 && jsonEnd !== -1) {\n    const jsonString = rawText.substring(jsonStart, jsonEnd);\n    const scenes = JSON.parse(jsonString);\n    return Array.isArray(scenes) ? scenes : [scenes];\n  } else {\n    // إذا لم يرسل Gemini تنسيق JSON، نحول النص كاملاً لمشهد واحد كخطة احتياطية\n    return [{\n      text: rawText,\n      image_prompt: \"abstract technology background, cinematic lighting\",\n      duration: 7\n    }];\n  }\n} catch (e) {\n  // في حال حدوث أي خطأ في التحويل\n  return [{\n    text: \"خطأ في معالجة البيانات من Gemini\",\n    image_prompt: \"error screen background\",\n    duration: 5\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
