    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\nconst html = `\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  margin: 40px;\n  color: #333;\n}\nh1 {\n  border-bottom: 2px solid #007bff;\n}\n.section {\n  margin-top: 20px;\n}\n.section h2 {\n  color: #007bff;\n  font-size: 18px;\n}\nul {\n  padding-left: 20px;\n}\n</style>\n</head>\n<body>\n\n<h1>${data.prenom} ${data.nom}</h1>\n<p>${data.ville} | ${data.email} | ${data.telephone}</p>\n\n<div class=\"section\">\n<h2>Profil professionnel</h2>\n<p>${data.profil || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Compétences</h2>\n<ul>\n${(data.competences || []).map(c => `<li>${c}</li>`).join(\"\")}\n</ul>\n</div>\n\n<div class=\"section\">\n<h2>Expériences</h2>\n${(data.experiences || []).map(e => `\n<p><strong>${e.poste}</strong> – ${e.entreprise}<br>\n${e.date_debut} - ${e.date_fin}<br>\n${e.description}</p>\n`).join(\"\")}\n</div>\n\n<div class=\"section\">\n<h2>Formation</h2>\n${(data.formations || []).map(f => `\n<p>${f.diplome} – ${f.etablissement} (${f.annee})</p>\n`).join(\"\")}\n</div>\n\n<div class=\"section\">\n<h2>Langues</h2>\n<p>${(data.langues || []).join(\", \")}</p>\n</div>\n\n</body>\n</html>\n`;\n\nreturn [\n  {\n    json: {\n      html\n    }\n  }\n];\n"
      },
