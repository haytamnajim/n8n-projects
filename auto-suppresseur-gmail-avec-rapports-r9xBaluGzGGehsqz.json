    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet totalBytes = 0;\nlet stats = {\n  newsletters: 0,\n  gros: 0,\n  anciens: 0,\n  pieces_jointes: 0\n};\n\nitems.forEach(item => {\n  // Calcul taille\n  if (item.json.sizeEstimate) {\n    totalBytes += item.json.sizeEstimate;\n  }\n  \n  // Détection Catégorie (Logique simplifiée)\n  const labels = item.json.labelIds || [];\n  const size = item.json.sizeEstimate || 0;\n  \n  if (labels.includes('CATEGORY_PROMOTIONS')) {\n    stats.newsletters++;\n  } else if (size > 10485760) { // > 10 Mo\n    stats.gros++;\n  } else if (item.json.payload?.mimeType !== 'text/plain' && size > 5242880) { // PJ > 5Mo\n     stats.pieces_jointes++;\n  } else {\n    stats.anciens++; // Le reste = anciens\n  }\n});\n\nconst totalMB = (totalBytes / (1024 * 1024)).toFixed(2);\n\n// Stocker tout dans la mémoire\n$execution.customData.set('totalSize', String(totalMB));\n$execution.customData.set('totalEmails', String(items.length));\n$execution.customData.set('stats', JSON.stringify(stats)); // <-- IMPORTANT : stringify\n\nreturn items;"
      },
