    {
      "parameters": {
        "jsCode": "// Remove duplicate jobs\nconst existingJobs = $node['Get Existing Jobs (Check Duplicates)'].json.values || [];\nconst existingUrls = existingJobs.slice(1).map(row => row[4]); // URL column (index 4)\n\nconst newJobs = $input.all().filter(item => {\n  return !existingUrls.includes(item.json.url);\n});\n\nconsole.log(`Found ${newJobs.length} new unique jobs`);\nreturn newJobs;"
      },
