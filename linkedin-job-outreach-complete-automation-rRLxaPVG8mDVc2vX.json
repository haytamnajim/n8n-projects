    {
      "parameters": {
        "jsCode": "// Generate email content for application\nconst hiringManager = $json.hiringManager || 'Hiring Manager';\nconst company = $json.company;\nconst role = $json.title;\nconst bulletPoints = $json.bulletPoints || [];\n\nconst emailBody = `Hi ${hiringManager},\n\nI came across the ${role} position at ${company} and was impressed by your company's innovation in this space.\n\nWith my 5+ years of experience in software development and proven track record of delivering high-impact solutions, I believe I can contribute significantly to your team.\n\nKey highlights:\n${bulletPoints.map(point => `• ${point}`).join('\\n')}\n\nI've attached my personalized resume and would love to discuss how my background aligns with your needs.\n\nBest regards,\nHaitam Najim\nhaytamnajim07@gmail.com`;\n\nreturn {\n  ...{{$json}},\n  emailSubject: `Application: ${role} at ${company}`,\n  emailBody: emailBody,\n  emailTo: {{$json.hiringEmail}}\n};"
      },
