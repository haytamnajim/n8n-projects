    {
      "parameters": {
        "jsCode": "// Generate personalized LinkedIn message\nconst hiringManager = $json.hiringManager || 'Hiring Manager';\nconst company = $json.company;\nconst role = $json.title;\nconst matchedSkills = $json.matchedTechSkills || [];\n\nconst linkedinMessage = `Hi ${hiringManager},\\n\\nI came across the ${role} opening at ${company} and was impressed by your company's innovation.\\n\\nWith my 5+ years in software development and expertise in ${matchedSkills.join(', ')}, I believe I can drive significant impact on your team.\\n\\nWould love to discuss how my background aligns with your needs.\\n\\nBest,\\nHaitam Najim`;\n\nreturn {\n  ...{{$json}},\n  linkedinMessage,\n  linkedinMessageLength: linkedinMessage.length\n};"
      },
